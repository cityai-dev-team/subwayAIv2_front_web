# Multi-stage build for React app (오프라인 모드)
FROM node:20-alpine AS builder

WORKDIR /app

# 빌드 시 필요한 환경 변수 (ARG로 받아서 ENV로 전달)
ARG VITE_API_BASE
ARG VITE_API_PREFIX
ARG VITE_APP_TITLE
ARG VITE_APP_VERSION

ENV VITE_API_BASE=${VITE_API_BASE}
ENV VITE_API_PREFIX=${VITE_API_PREFIX}
ENV VITE_APP_TITLE=${VITE_APP_TITLE}
ENV VITE_APP_VERSION=${VITE_APP_VERSION}

# 의존성 파일 복사 (빌드 컨텍스트가 상위 디렉토리이므로 경로 조정)
COPY subwayAIv2_front_web/package*.json ./

# 오프라인 환경: 로컬에 저장된 npm 패키지 사용
# 빌드 컨텍스트가 상위 디렉토리이므로 subwayAIv2_images/front_web 경로 사용 가능
# npm 패키지 디렉토리 생성
RUN mkdir -p /tmp/npm-packages

# npm 패키지 복사 (tarball 파일들)
# COPY는 파일이 없으면 실패하므로, 빌드 전에 의존성 다운로드 필요
COPY subwayAIv2_images/front_web/npm-packages/*.tgz /tmp/npm-packages/ 2>/dev/null || true
COPY subwayAIv2_images/front_web/npm-packages/package-lock.json /tmp/npm-packages/ 2>/dev/null || true

# 오프라인 설치: 로컬 npm 패키지 우선 사용, 없으면 일반 설치
RUN if [ -d /tmp/npm-packages ] && [ "$(ls -A /tmp/npm-packages/*.tgz 2>/dev/null)" ]; then \
        echo "오프라인 모드: 로컬 npm 패키지 사용" && \
        npm ci --prefer-offline --no-audit --offline || \
        npm ci --prefer-offline --no-audit; \
    else \
        echo "경고: npm 패키지가 없습니다. 일반 설치를 시도합니다." && \
        npm ci --prefer-offline --no-audit; \
    fi

# 소스 코드 복사 및 빌드 (빌드 컨텍스트가 상위 디렉토리이므로 경로 조정)
COPY subwayAIv2_front_web/ .
RUN npm run build

# Production stage with nginx
FROM nginx:alpine

# 빌드 결과물 복사
COPY --from=builder /app/dist /usr/share/nginx/html

# nginx 설정 파일 복사 (빌드 컨텍스트가 상위 디렉토리이므로 경로 조정)
COPY subwayAIv2_front_web/nginx.conf /etc/nginx/conf.d/default.conf

# 포트 노출
EXPOSE 3001

# 헬스체크
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:3001/ || exit 1

CMD ["nginx", "-g", "daemon off;"]


