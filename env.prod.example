# ============================================
# SubwayAI v2 Front Web - 운영 환경 변수 설정
# ============================================
# 사용법: cp env.prod.example .env.prod
#         nano .env.prod (실제 값으로 수정)

# ===== Infra / Naming =====
PROJECT=subwayAIv2
NET=subwayAIv2_net
C_WEB=subwayaiv2-front-web-prod
IMAGE_NAME=subwayaiv2-front-web

# ===== App =====
APP_PORT=3001

# ===== API Server =====
# API 서버 주소 (api_web 포트 8001)
# 운영 환경에서는 다른 서버에 있을 수 있으므로 절대 URL로 설정
# 예: http://180.226.218.198:8001 또는 http://api.example.com:8001
# 빈 값으로 두면 상대 경로(/api)로 요청 (같은 서버에 있는 경우)
VITE_API_BASE=http://localhost:8001
# 또는 같은 Docker 네트워크에 있는 경우:
# VITE_API_BASE=http://subwayaiv2-api-web-prod:8001
# 또는 외부 도메인을 사용하는 경우:
# VITE_API_BASE=https://api.example.com

VITE_API_PREFIX=/api

# ===== App Settings =====
VITE_APP_TITLE="SubwayAI v2 관리 대시보드"
VITE_APP_VERSION=1.0.0

