### 5.2 데이터 로딩 전략

**1. 초기 로딩**:
```typescript
useEffect(() => {
  fetchInitialData();
}, []);
```

**2. 자동 갱신 (폴링)**:
```typescript
useEffect(() => {
  const interval = setInterval(() => {
    fetchData();
  }, 5000);
  
  return () => clearInterval(interval);
}, []);
```

**3. 에러 처리**:
```typescript
const fetchData = async (retryCount = 3) => {
  try {
    const response = await fetch('/api/v1/web/dashboard/overview');
    if (!response.ok) throw new Error('API Error');
    const data = await response.json();
    setData(data.data);
  } catch (error) {
    if (retryCount > 0) {
      setTimeout(() => fetchData(retryCount - 1), 2000);
    } else {
      message.error('데이터 로딩 실패. 네트워크를 확인하세요.');
    }
  }
};
```

