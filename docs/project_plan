```typescript
// React Hooks 기반 상태 관리
const [overviewData, setOverviewData] = useState<OverviewData | null>(null);
const [trendData, setTrendData] = useState<TrendData[]>([]);
const [regionsData, setRegionsData] = useState<RegionData[]>([]);
