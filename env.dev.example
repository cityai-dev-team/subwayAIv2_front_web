# ============================================
# SubwayAI v2 Front Web - 개발 환경 변수 설정
# ============================================
# 사용법: cp env.dev.example .env.dev
#         nano .env.dev (실제 값으로 수정)

# ===== Infra / Naming =====
PROJECT=subwayAIv2
NET=subwayAIv2_net
C_WEB=subwayaiv2-front-web-dev
IMAGE_NAME=subwayaiv2-front-web

# ===== App =====
APP_PORT=3001

# ===== API Server =====
# API 서버 주소 (api_web 포트 8001)
# 브라우저에서 접근하므로 localhost 사용 (Vite proxy 활용)
# 빈 값으로 두면 Vite proxy를 통해 /api 경로가 자동으로 localhost:8001로 프록시됨
VITE_API_BASE=http://localhost:8001
# 또는 명시적으로 설정하려면:
# VITE_API_BASE=http://localhost:8001

VITE_API_PREFIX=/api

# ===== Vite Proxy Target =====
# Vite 개발 서버의 프록시 타겟 (Docker 컨테이너 내부에서 백엔드 접근용)
# 호스트에서 실행 시: http://localhost:8001
# Docker 컨테이너에서 실행 시: http://subwayaiv2-api-web-dev:8001 (Docker 네트워크 사용)
# VITE_API_PROXY_TARGET=http://localhost:8001

# ===== App Settings =====
VITE_APP_TITLE="SubwayAI v2 관리 대시보드"
VITE_APP_VERSION=1.0.0-dev

